{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "shelf/ai/propose_links.schema.json",
 "type": "object",
 "required": [
  "links"
 ],
 "properties": {
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "toBookId",
     "reason",
     "confidence"
    ],
    "properties": {
     "toBookId": {
      "type": "string"
     },
     "reason": {
      "type": "string",
      "maxLength": 120
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    }
   }
  }
 }
}