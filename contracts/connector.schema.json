{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://philobiblos.invalid/contracts/connector.schema.json",
  "title": "Connector",
  "description": "A bookshop as data (contracts/connectors.md, docs/connectors.md): who it mails from, how its mails read, where its prices are. Data only: no code, no regular expression, every host exact. Every object refuses keys it does not name, so a connector cannot add a setting (an unsigned mail, a private address) the core does not have.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "locale", "money"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$" },
    "name": { "$ref": "#/$defs/text" },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "language"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }
      }
    },
    "money": {
      "description": "How amounts are written: a symbol before the amount, or after it; the amount itself is always 1 to 4 digits, '.' or ',', 2 digits.",
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/symbols" },
        "after": { "$ref": "#/$defs/symbols" }
      }
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "reply", "summary", "unavailable"],
      "properties": {
        "domains": { "description": "The From (and Sender) domains, exact: no subdomain counts unless it is listed.", "$ref": "#/$defs/hosts" },
        "dkim_domains": { "description": "The signing domains whose DKIM counts, exact (default: domains).", "$ref": "#/$defs/hosts" },
        "reply": {
          "description": "Where the household's quoted request begins in a reply: nothing from there on is read.",
          "type": "object",
          "additionalProperties": false,
          "required": ["separators", "header_labels", "attribution_starts", "attribution_verbs"],
          "properties": {
            "separators": { "$ref": "#/$defs/phrases" },
            "header_labels": { "$ref": "#/$defs/phrases" },
            "attribution_starts": { "$ref": "#/$defs/phrases" },
            "attribution_verbs": { "$ref": "#/$defs/phrases" }
          }
        },
        "summary": { "description": "Lines whose amount is no book's (totals, postage, discounts, VAT), by their first words; a trailing * is any word beginning so.", "$ref": "#/$defs/words" },
        "unavailable": { "$ref": "#/$defs/phrases" },
        "quote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["senders", "labels", "confirm_phrases", "order_number_labels"],
          "properties": {
            "senders": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/email" } },
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "required": ["author", "title", "isbn", "price", "delivery"],
              "properties": {
                "author": { "$ref": "#/$defs/phrases" },
                "title": { "$ref": "#/$defs/phrases" },
                "isbn": { "$ref": "#/$defs/phrases" },
                "price": { "$ref": "#/$defs/phrases" },
                "delivery": { "$ref": "#/$defs/phrases" }
              }
            },
            "confirm_phrases": { "$ref": "#/$defs/phrases" },
            "order_number_labels": { "$ref": "#/$defs/phrases" }
          }
        },
        "shop": {
          "description": "Web orders and click & collect: one line per article, `<kind> <title> <by> <author> [<ean_label>: <ean>] | [<n> x ]<symbol> <price>`.",
          "type": "object",
          "additionalProperties": false,
          "required": ["book_kinds", "skip_kinds", "by", "ean_label"],
          "properties": {
            "online_order_subjects": { "$ref": "#/$defs/subjects" },
            "click_collect_subjects": { "$ref": "#/$defs/subjects" },
            "book_kinds": { "$ref": "#/$defs/kinds" },
            "skip_kinds": { "$ref": "#/$defs/kinds" },
            "by": { "$ref": "#/$defs/word" },
            "ean_label": { "$ref": "#/$defs/word" }
          }
        },
        "invoice": {
          "description": "Invoice PDFs, rows `EAN  Title  qty <unit>  price  [discount %]  total <currency>  VAT %`.",
          "type": "object",
          "additionalProperties": false,
          "required": ["subjects", "unit", "total_words", "postage_words"],
          "properties": {
            "subjects": { "$ref": "#/$defs/subjects" },
            "unit": { "$ref": "#/$defs/word" },
            "total_words": { "$ref": "#/$defs/words" },
            "postage_words": { "$ref": "#/$defs/words" }
          }
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": { "to": { "description": "Where Compose addresses the order unless an admin set another address.", "$ref": "#/$defs/email" } }
    },
    "prices": {
      "description": "A read-only price lookup on the shop's search page, read as text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "article", "print_formats", "want_languages", "other_languages", "availability"],
      "properties": {
        "kind": { "const": "search_tiles" },
        "url": {
          "description": "https on the default port, an exact host, and {query} once, in the query string.",
          "type": "string",
          "maxLength": 200,
          "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?/[A-Za-z0-9/._~-]*\\?(?:[A-Za-z0-9._~-]+=[A-Za-z0-9._~-]*&)*[A-Za-z0-9._~-]+=\\{query\\}(?:&[A-Za-z0-9._~-]+=[A-Za-z0-9._~-]*)*$"
        },
        "article": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "id_prefix", "id_digits"],
          "properties": {
            "path": { "type": "string", "pattern": "^/[A-Za-z0-9/._~-]{0,99}/$" },
            "id_prefix": { "type": "string", "pattern": "^[A-Za-z]{0,4}$" },
            "id_digits": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 1, "maximum": 20 }, { "type": "integer", "minimum": 1, "maximum": 20 }], "minItems": 2, "maxItems": 2 }
          }
        },
        "print_formats": { "$ref": "#/$defs/phrases" },
        "want_languages": { "$ref": "#/$defs/phrases" },
        "other_languages": { "$ref": "#/$defs/phrases" },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phrases", "joiners", "units"],
          "properties": {
            "phrases": { "$ref": "#/$defs/phrases" },
            "joiners": { "$ref": "#/$defs/phrases" },
            "units": { "$ref": "#/$defs/phrases" }
          }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\p{Cf}<>]+$" },
    "phrase": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\p{Cf}*{}]+$" },
    "phrases": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/phrase" } },
    "word": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f\\p{Cf}*{}|]+$" },
    "words": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\p{Cf}*{}]+\\*?$" } },
    "kinds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/word" } },
    "symbols": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[^\\s\\d\\u0000-\\u001f\\u007f-\\u009f\\p{Cf}*{}]+$" } },
    "subjects": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "type": "string", "minLength": 9, "maxLength": 120, "pattern": "^[^{}\\u0000-\\u001f\\u007f-\\u009f\\p{Cf}*]*\\{number\\}[^{}\\u0000-\\u001f\\u007f-\\u009f\\p{Cf}*]*$" }
    },
    "host": { "type": "string", "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "hosts": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/host" } },
    "email": { "type": "string", "maxLength": 254, "pattern": "^[a-z0-9._+-]{1,64}@(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$" }
  }
}
